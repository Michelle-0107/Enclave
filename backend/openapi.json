{
  "openapi": "3.1.0",
  "info": {
    "title": "Enclave Backend API",
    "description": "Supabase JWT authentication, resident OTP registration, owner-only reports, and S3/AI submission.",
    "version": "0.4.0"
  },
  "paths": {
    "/api/v1/registration/request-otp": {
      "post": {
        "tags": [
          "Registration"
        ],
        "summary": "Request Otp",
        "operationId": "request_otp_api_v1_registration_request_otp_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestOTP"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OTPAccepted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/send-verification-email": {
      "post": {
        "tags": [
          "Registration"
        ],
        "summary": "Request Otp",
        "operationId": "request_otp_api_send_verification_email_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestOTP"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OTPAccepted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "deprecated": true
      }
    },
    "/api/v1/registration/verify-and-signup": {
      "post": {
        "tags": [
          "Registration"
        ],
        "summary": "Verify Signup",
        "operationId": "verify_signup_api_v1_registration_verify_and_signup_post",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 32,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$",
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifySignup"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignupResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/residency": {
      "get": {
        "tags": [
          "Registration"
        ],
        "summary": "My Residency",
        "operationId": "my_residency_api_v1_me_residency_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Residency"
                }
              }
            }
          }
        },
        "security": [
          {
            "SupabaseAccessToken": []
          }
        ]
      }
    },
    "/api/v1/management/residents": {
      "post": {
        "tags": [
          "Registration",
          "Management"
        ],
        "summary": "Create Resident",
        "operationId": "create_resident_api_v1_management_residents_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResidentInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "SupabaseAccessToken": []
          }
        ]
      }
    },
    "/api/v1/management/residents/{resident_id}/invitations": {
      "post": {
        "tags": [
          "Registration",
          "Management"
        ],
        "summary": "Issue Invitation",
        "operationId": "issue_invitation_api_v1_management_residents__resident_id__invitations_post",
        "security": [
          {
            "SupabaseAccessToken": []
          }
        ],
        "parameters": [
          {
            "name": "resident_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Resident Id"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Me",
        "operationId": "me_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired access token."
          },
          "503": {
            "description": "Verification keys are unavailable."
          }
        },
        "security": [
          {
            "SupabaseAccessToken": []
          }
        ]
      }
    },
    "/api/v1/reports": {
      "post": {
        "tags": [
          "Reports"
        ],
        "summary": "Submit Report",
        "operationId": "submit_report_api_v1_reports_post",
        "security": [
          {
            "SupabaseAccessToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_submit_report_api_v1_reports_post"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportCreatedResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials."
          },
          "403": {
            "description": "Database policy denied access."
          },
          "503": {
            "description": "Cloud service unavailable."
          },
          "413": {
            "description": "Photo exceeds 10 MiB."
          },
          "415": {
            "description": "Unsupported photo type."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "My Reports",
        "operationId": "my_reports_api_v1_reports_get",
        "security": [
          {
            "SupabaseAccessToken": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 10,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials."
          },
          "403": {
            "description": "Database policy denied access."
          },
          "503": {
            "description": "Cloud service unavailable."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reports/{ticket_id}": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "Report Detail",
        "operationId": "report_detail_api_v1_reports__ticket_id__get",
        "security": [
          {
            "SupabaseAccessToken": []
          }
        ],
        "parameters": [
          {
            "name": "ticket_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$",
              "title": "Ticket Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials."
          },
          "403": {
            "description": "Database policy denied access."
          },
          "503": {
            "description": "Cloud service unavailable."
          },
          "404": {
            "description": "Unknown or inaccessible report."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AIAnalysis": {
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "Streetlight",
              "Damaged Facility",
              "Blocked Path",
              "Drainage",
              "Waste"
            ],
            "title": "Category"
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "title": "Priority"
          },
          "summary": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Summary"
          }
        },
        "type": "object",
        "required": [
          "category",
          "priority",
          "summary"
        ],
        "title": "AIAnalysis"
      },
      "AuthSession": {
        "properties": {
          "access_token": {
            "type": "string",
            "maxLength": 16384,
            "minLength": 1,
            "title": "Access Token"
          },
          "refresh_token": {
            "type": "string",
            "maxLength": 8192,
            "minLength": 1,
            "title": "Refresh Token"
          },
          "token_type": {
            "type": "string",
            "const": "bearer",
            "title": "Token Type",
            "default": "bearer"
          },
          "expires_in": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Expires In"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "refresh_token",
          "expires_in"
        ],
        "title": "AuthSession"
      },
      "Body_submit_report_api_v1_reports_post": {
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Description"
          },
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          },
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "description",
          "latitude",
          "longitude",
          "file"
        ],
        "title": "Body_submit_report_api_v1_reports_post"
      },
      "CurrentUserResponse": {
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "email"
        ],
        "title": "CurrentUserResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InvitationResult": {
        "properties": {
          "invitation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Invitation Id"
          },
          "resident_id": {
            "type": "string",
            "format": "uuid",
            "title": "Resident Id"
          },
          "invitation_token": {
            "type": "string",
            "title": "Invitation Token"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "invitation_id",
          "resident_id",
          "invitation_token",
          "expires_at"
        ],
        "title": "InvitationResult"
      },
      "OTPAccepted": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "format": "uuid",
            "title": "Challenge Id"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": "If the invitation is eligible, a verification email will be sent."
          }
        },
        "type": "object",
        "required": [
          "challenge_id"
        ],
        "title": "OTPAccepted"
      },
      "ReportCreatedResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "const": true,
            "title": "Success",
            "default": true
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": "Report successfully created, analyzed by AI, and stored."
          },
          "ticket_id": {
            "type": "string",
            "title": "Ticket Id"
          },
          "ai_analysis": {
            "$ref": "#/components/schemas/AIAnalysis"
          },
          "image_url": {
            "type": "string",
            "title": "Image Url"
          },
          "data": {
            "items": {
              "$ref": "#/components/schemas/ReportResponse"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "ticket_id",
          "ai_analysis",
          "image_url",
          "data"
        ],
        "title": "ReportCreatedResponse"
      },
      "ReportListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ReportResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "limit",
          "offset"
        ],
        "title": "ReportListResponse"
      },
      "ReportResponse": {
        "properties": {
          "ticket_id": {
            "type": "string",
            "title": "Ticket Id"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "title": "Longitude"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "priority": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Priority"
          },
          "is_approved": {
            "type": "boolean",
            "title": "Is Approved",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "ticket_id",
          "user_id",
          "description",
          "status",
          "latitude",
          "longitude"
        ],
        "title": "ReportResponse"
      },
      "RequestOTP": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "invitation_token": {
            "type": "string",
            "maxLength": 128,
            "minLength": 40,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Invitation Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "invitation_token"
        ],
        "title": "RequestOTP"
      },
      "Residency": {
        "properties": {
          "resident_id": {
            "type": "string",
            "format": "uuid",
            "title": "Resident Id"
          },
          "unit_number": {
            "type": "string",
            "title": "Unit Number"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ],
            "title": "Status"
          },
          "verified_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verified At"
          }
        },
        "type": "object",
        "required": [
          "resident_id",
          "unit_number",
          "status",
          "verified_at"
        ],
        "title": "Residency"
      },
      "ResidentInput": {
        "properties": {
          "resident_reference": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Resident Reference"
          },
          "full_name": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1,
            "title": "Full Name"
          },
          "unit_number": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Unit Number"
          },
          "registered_email": {
            "type": "string",
            "format": "email",
            "title": "Registered Email"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "resident_reference",
          "full_name",
          "unit_number",
          "registered_email"
        ],
        "title": "ResidentInput"
      },
      "SignupResult": {
        "properties": {
          "status": {
            "type": "string",
            "const": "registered",
            "title": "Status",
            "default": "registered"
          },
          "resident_id": {
            "type": "string",
            "format": "uuid",
            "title": "Resident Id"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "session": {
            "$ref": "#/components/schemas/AuthSession"
          }
        },
        "type": "object",
        "required": [
          "resident_id",
          "user_id",
          "session"
        ],
        "title": "SignupResult"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VerifySignup": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "format": "uuid",
            "title": "Challenge Id"
          },
          "otp": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "title": "Otp"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "format": "password",
            "title": "Password",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "challenge_id",
          "otp",
