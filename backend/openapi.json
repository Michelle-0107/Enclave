{
  "openapi": "3.1.0",
  "info": {
    "title": "Enclave Backend API",
    "description": "Supabase JWT authentication, owner-only cloud reports, and S3/AI report submission.",
    "version": "0.3.0"
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Me",
        "operationId": "me_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired access token."
          },
          "503": {
            "description": "Verification keys are unavailable."
          }
        },
        "security": [
          {
            "SupabaseAccessToken": []
          }
        ]
      }
    },
    "/api/v1/reports": {
      "post": {
        "tags": [
          "Reports"
        ],
        "summary": "Submit Report",
        "operationId": "submit_report_api_v1_reports_post",
        "security": [
          {
            "SupabaseAccessToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_submit_report_api_v1_reports_post"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportCreatedResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials."
          },
          "403": {
            "description": "Database policy denied access."
          },
          "503": {
            "description": "Cloud service unavailable."
          },
          "413": {
            "description": "Photo exceeds 10 MiB."
          },
          "415": {
            "description": "Unsupported photo type."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "My Reports",
        "operationId": "my_reports_api_v1_reports_get",
        "security": [
          {
            "SupabaseAccessToken": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 10,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials."
          },
          "403": {
            "description": "Database policy denied access."
          },
          "503": {
            "description": "Cloud service unavailable."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reports/{ticket_id}": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "Report Detail",
        "operationId": "report_detail_api_v1_reports__ticket_id__get",
        "security": [
          {
            "SupabaseAccessToken": []
          }
        ],
        "parameters": [
          {
            "name": "ticket_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$",
              "title": "Ticket Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials."
          },
          "403": {
            "description": "Database policy denied access."
          },
          "503": {
            "description": "Cloud service unavailable."
          },
          "404": {
            "description": "Unknown or inaccessible report."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AIAnalysis": {
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "Streetlight",
              "Damaged Facility",
              "Blocked Path",
              "Drainage",
              "Waste"
            ],
            "title": "Category"
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "title": "Priority"
          },
          "summary": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Summary"
          }
        },
        "type": "object",
        "required": [
          "category",
          "priority",
          "summary"
        ],
        "title": "AIAnalysis"
      },
      "Body_submit_report_api_v1_reports_post": {
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Description"
          },
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          },
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "description",
          "latitude",
          "longitude",
          "file"
        ],
        "title": "Body_submit_report_api_v1_reports_post"
      },
      "CurrentUserResponse": {
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "email"
        ],
        "title": "CurrentUserResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ReportCreatedResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "const": true,
            "title": "Success",
            "default": true
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": "Report successfully created, analyzed by AI, and stored."
          },
          "ticket_id": {
            "type": "string",
            "title": "Ticket Id"
          },
          "ai_analysis": {
            "$ref": "#/components/schemas/AIAnalysis"
          },
          "image_url": {
            "type": "string",
            "title": "Image Url"
          },
          "data": {
            "items": {
              "$ref": "#/components/schemas/ReportResponse"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "ticket_id",
          "ai_analysis",
          "image_url",
          "data"
        ],
        "title": "ReportCreatedResponse"
      },
      "ReportListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ReportResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "limit",
          "offset"
        ],
        "title": "ReportListResponse"
      },
      "ReportResponse": {
        "properties": {
          "ticket_id": {
            "type": "string",
            "title": "Ticket Id"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "title": "Longitude"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "priority": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Priority"
          },
          "is_approved": {
            "type": "boolean",
            "title": "Is Approved",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "ticket_id",
          "user_id",
          "description",
          "status",
          "latitude",
          "longitude"
        ],
        "title": "ReportResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "SupabaseAccessToken": {
        "type": "http",
        "description": "Paste the Supabase Auth access_token, without the Bearer prefix.",
        "scheme": "bearer"
      }
    }
  }
}
