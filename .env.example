# Cloud backend configuration. Copy to .env and fill values locally.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Photo storage: use configured AWS credentials or the deployment's IAM role.
AWS_REGION=us-east-1
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# The legacy AWS_ACCESS_KEY name remains supported; do not configure different key IDs under both names.
# Optional Gemini fallback; Bedrock is attempted first.
GEMINI_API_KEY=
# Resident registration (server-only). Apply backend/sql/005_registration_transitions.sql first.
SUPABASE_SECRET_KEY=
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY. Configure one Admin key name only.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(32))"
OTP_HMAC_SECRET=
OTP_HMAC_VERSION=1
